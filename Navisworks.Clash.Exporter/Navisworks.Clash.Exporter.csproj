<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <!-- Navisworks Manage 2026 install folder (override with /p:NavisworksPath=...) -->
        <NavisworksPath Condition="'$(NavisworksPath)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2026</NavisworksPath>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Autodesk.Navisworks.Api">
            <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Api.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Autodesk.Navisworks.Clash">
            <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Clash.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Autodesk.Navisworks.ComApi">
            <HintPath>$(NavisworksPath)\Autodesk.Navisworks.ComApi.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="Autodesk.Navisworks.Interop.ComApi">
            <HintPath>$(NavisworksPath)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" Version="0.104.2" />
        <!-- Build-time only: merges all managed dependencies into a single plugin DLL. -->
        <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" PrivateAssets="all" />
    </ItemGroup>

    <!-- Icons are embedded in the plugin DLL (referenced by resource name for the add-in and
         command icons). -->
    <ItemGroup>
        <EmbeddedResource Include="Images\Icon_16.png" />
        <EmbeddedResource Include="Images\Icon_32.png" />
    </ItemGroup>

    <!-- The RME Tools ribbon layout must ship as a loose file in a culture sub-folder (en-US)
         next to the DLL; Navisworks cannot load it from an embedded resource. -->
    <ItemGroup>
        <Content Include="en-US\RmeToolsRibbon.xaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- The single-DLL merge is driven by ILRepack.targets (next to this file), which also
         disables the package's built-in auto-merge so we can supply the Navisworks search path. -->

</Project>
